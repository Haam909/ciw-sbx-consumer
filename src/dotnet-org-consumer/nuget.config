<?xml version="1.0" encoding="utf-8"?>
<!-- Adds the org-scoped Azure Artifacts Feed to the sources in the repo root's nuget.config. -->
<configuration>
  <packageSources>
    <add key="ci-workflow-org" value="https://pkgs.dev.azure.com/ci-workflow-testing/_packaging/ci-workflow-org/nuget/v3/index.json" />
  </packageSources>
</configuration>
